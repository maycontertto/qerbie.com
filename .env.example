# ─── Supabase ──────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.qerbie.com

# ─── Assistente de IA (ai/) ────────────────────────────────
# Provedor ativo: ollama | openai | groq | deepseek
AI_PROVIDER=groq

# Usado quando AI_PROVIDER=openai|groq|deepseek
# Groq: gere em https://console.groq.com/keys (chave começa com gsk_)
AI_PROVIDER_API_KEY=
# Groq: um ID exato da lista em https://console.groq.com/docs/models
# (copie certinho, sem aspas/espaços - ex.: llama-3.1-8b-instant)
AI_PROVIDER_MODEL=llama-3.3-70b-versatile

# Usado apenas quando AI_PROVIDER=ollama (servidor próprio)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=
